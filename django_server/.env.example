# ==============================================================================
# SECURE REAL-TIME MESSAGING PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env in django_server/ directory and adjust values.
# NEVER commit your actual .env file with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO CORE SETTINGS
# ------------------------------------------------------------------------------
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-at-least-50-characters-long
PUBLIC_DOMAIN=chat.yourdomain.com
SERVER_IP=203.0.113.10
CLIENT_URL=https://chat.yourdomain.com
DJANGO_ALLOWED_HOSTS=chat.yourdomain.com,203.0.113.10,127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=https://chat.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://chat.yourdomain.com
API_BASE_URL=https://chat.yourdomain.com
WEBSOCKET_URL=wss://chat.yourdomain.com/ws/chat/

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Strict MySQL 8+ Exclusively)
# ------------------------------------------------------------------------------
DATABASE_NAME=chat_db
DATABASE_USER=chat_user
DATABASE_PASSWORD=your_strong_mysql_password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DB_CONN_MAX_AGE=600

# ------------------------------------------------------------------------------
# 3. CACHE & CHANNEL LAYER (Redis 7+ and Redis Streams)
# ------------------------------------------------------------------------------
USE_REDIS=True
REDIS_URL=redis://127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# 4. PRIVATE EBS FILE STORAGE
# ------------------------------------------------------------------------------
STORAGE_ROOT=/var/chat_storage/private
MAX_UPLOAD_SIZE_BYTES=104857600
USER_STORAGE_QUOTA_BYTES=5368709120

# ------------------------------------------------------------------------------
# 5. JWT TOKEN LIFETIMES
# ------------------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL & EMAIL OTP (Passwordless OTP, Security Alerts)
# ------------------------------------------------------------------------------
# For Gmail, generate a 16-character App Password:
# 1. Go to Google Account -> Security -> 2-Step Verification -> App Passwords
# 2. Name it "ChatApp" and copy the 16-character code (paste without spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL="Secure Chat <your_email@gmail.com>"
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# ------------------------------------------------------------------------------
# 7. OAUTH 2.0 PROVIDERS (Google, GitHub, Facebook)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: https://chat.yourdomain.com/api/auth/oauth/google/callback/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth App (GitHub -> Settings -> Developer settings -> OAuth Apps)
# Authorization callback URL: https://chat.yourdomain.com/api/auth/oauth/github/callback/
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Facebook Login (Meta for Developers -> App Dashboard)
# Valid OAuth Redirect URIs: https://chat.yourdomain.com/api/auth/oauth/facebook/callback/
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ------------------------------------------------------------------------------
# 8. WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY=your_base64url_encoded_vapid_public_key
VAPID_PRIVATE_KEY=your_base64url_encoded_vapid_private_key
VAPID_CLAIM_EMAIL=mailto:admin@yourdomain.com

# ------------------------------------------------------------------------------
# 9. ANDROID PUSH NOTIFICATIONS (Direct Native Firebase Cloud Messaging HTTP v1)
# ------------------------------------------------------------------------------
FCM_PROJECT_ID=your-firebase-project-id
FCM_SERVICE_ACCOUNT_PATH=/etc/chat/service-account.json
