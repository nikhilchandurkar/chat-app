# ==============================================================================
# Django Daphne ASGI Server Configuration
# ==============================================================================

# Core Settings
DEBUG=True
SECRET_KEY=django-insecure-chat-app-dev-secret-key-12345
ADMIN_SECRET_KEY=chat_app_secret
PORT=8000
CLIENT_URL=https://nikhil-chats.chickenkiller.com

# Database: PostgreSQL Only
DATABASE_URL=postgresql://chat_user:chat_password@127.0.0.1:5432/chat_db

# Redis & Channels (Set USE_REDIS=True when Redis is running; False uses in-memory)
USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/0

# Message Encryption (AES-256-CBC 32-character key)
MESSAGE_ENCRYPTION_KEY=12345678901234567890123456789012

# Email Delivery (Gmail App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

