# ==============================================================================
# Chat App – Environment Configuration Example
# Copy to .env and fill in values. Never commit .env.
# ==============================================================================

# ── Core Django ────────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=replace-with-50-char-random-string
ADMIN_SECRET_KEY=replace-with-strong-admin-secret
PORT=8000
CLIENT_URL=http://localhost:5173
ALLOWED_HOSTS=*

# ── Database — MySQL (dev and prod) ───────────────────────────────────────────
DB_ENGINE=mysql
MYSQL_DATABASE=chat_db
MYSQL_USER=chat_user
MYSQL_PASSWORD=chat_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
DB_CONN_MAX_AGE=600

# SQLite only for CI tests (no external service needed)
SQLITE_PATH=./db.sqlite3

# ── Redis ──────────────────────────────────────────────────────────────────────
USE_REDIS=True
REDIS_URL=redis://127.0.0.1:6379/0

# ── Message Encryption (exactly 32 chars) ─────────────────────────────────────
MESSAGE_ENCRYPTION_KEY=12345678901234567890123456789012

# ── Email ──────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ── Celery ─────────────────────────────────────────────────────────────────────
CELERY_CONCURRENCY=2

# ── Rate Limiting ──────────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT=5
OTP_RATE_LIMIT=3
API_RATE_LIMIT=60
