# ==============================================================================
# Chat App – Unified Environment Configuration Example
# Copy this to .env and fill in your values.
# One .env file covers both development and production.
# NEVER commit your actual .env to version control.
# ==============================================================================

# ── Core Django ────────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=django-insecure-replace-with-50-char-random-string
ADMIN_SECRET_KEY=replace-with-strong-admin-secret
PORT=8000
CLIENT_URL=http://localhost:5173

# ── Allowed Hosts ─────────────────────────────────────────────────────────────
# Dev: *   |   Prod: yourdomain.com 1.2.3.4
ALLOWED_HOSTS=*

# ── Database ───────────────────────────────────────────────────────────────────
# DB_ENGINE: postgresql | mysql | sqlite3
DB_ENGINE=postgresql

# LOCAL DEV: PostgreSQL running in Docker on your machine
DATABASE_URL=postgresql://chat_user:chat_password@127.0.0.1:5432/chat_db

# PRODUCTION (EC2): same var, different value set via GitHub Secret
# The host is still 127.0.0.1 because Django container runs with --network host
# on the same EC2 instance as PostgreSQL.
# GitHub Secret DATABASE_URL = postgresql://chat_user:chat_password@127.0.0.1:5432/chat_db
#
# If you move PostgreSQL to RDS or a separate server, just change the host:
# DATABASE_URL=postgresql://chat_user:chat_password@your-rds-endpoint:5432/chat_db

# MySQL (when DB_ENGINE=mysql)
MYSQL_DATABASE=chat_db
MYSQL_USER=chat_user
MYSQL_PASSWORD=chat_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# SQLite (when DB_ENGINE=sqlite3 – dev/test only)
SQLITE_PATH=./db.sqlite3

# ── Redis ──────────────────────────────────────────────────────────────────────
USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/0

# ── Message Encryption ────────────────────────────────────────────────────────
MESSAGE_ENCRYPTION_KEY=12345678901234567890123456789012

# ── Email ──────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ── Celery ─────────────────────────────────────────────────────────────────────
CELERY_CONCURRENCY=2

# ── Connection Pool ────────────────────────────────────────────────────────────
DB_CONN_MAX_AGE=600

# ── Rate Limiting ──────────────────────────────────────────────────────────────
LOGIN_RATE_LIMIT=5
OTP_RATE_LIMIT=3
API_RATE_LIMIT=60
