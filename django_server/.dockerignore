# Never bake secrets or local config into the image
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyc
.Python

# Test artifacts
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Development databases
db.sqlite3
db.sqlite3-journal

# Media and static (served from volumes)
media/
staticfiles/

# Logs
logs/
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo

# Git
.git/
.gitignore

# Docker files (not needed inside image)
Dockerfile
.dockerignore
docker-compose*.yml
docker_build.*

# CI/CD
.github/
