# ─── Email Configuration (Required for Forgot Password) ──────────────────────
# Option 1: Gmail (Recommended & easiest)
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and App Password below (spaces will be automatically trimmed)
EMAIL_SERVICE=gmail
EMAIL_USER=nikhilchandurkar24@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=nikhilchandurkar24@gmail.com

